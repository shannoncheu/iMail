# Development mode only. Production must set this to false.
USE_MOCK_DATA=true

# Application
APP_URL=http://localhost:3000
DATABASE_URL=
SESSION_SECRET=
# 32 random bytes encoded as base64url. Keep this different from SESSION_SECRET.
TOKEN_ENCRYPTION_KEY=

# Owner access. Prefer immutable provider IDs after initial bootstrap.
ALLOWED_EMAILS=
ALLOWED_GOOGLE_SUBJECTS=
ALLOWED_MICROSOFT_IDS=
ALLOWED_ZOHO_IDS=
# Comma-separated immutable numeric GitHub user IDs. GitHub login fails closed
# when this list is empty.
ALLOWED_GITHUB_IDS=

# Google identity and Gmail delegated access
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft personal accounts only
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=consumers

# Zoho Mail
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# GitHub identity only
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

