# Application
APP_URL=http://localhost:3000
DATABASE_URL=
SESSION_SECRET=
# 32 random bytes encoded as base64url. Keep this different from SESSION_SECRET.
TOKEN_ENCRYPTION_KEY=
# Active key version. Keep the previous key/version during a rolling rotation.
TOKEN_ENCRYPTION_KEY_VERSION=1
TOKEN_ENCRYPTION_KEY_PREVIOUS=
TOKEN_ENCRYPTION_KEY_PREVIOUS_VERSION=

# Comma-separated immutable numeric GitHub user IDs. GitHub login fails closed
# when this list is empty.
ALLOWED_GITHUB_IDS=

# Google identity and Gmail delegated access
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft personal accounts only
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=consumers

# Zoho Mail
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_MAIL_API_BASE_URL=https://mail.zoho.com

# Optional authenticated maintenance endpoint for platforms without Cron Triggers.
MAINTENANCE_SECRET=

# GitHub identity only
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

